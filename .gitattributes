# Scripts and configs consumed inside WSL must keep LF endings even when edited on Windows.
*.sh   text eol=lf
*.py   text eol=lf
*.xml  text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
# Git hooks run under sh (Git for Windows or WSL): no extension, so they need their own rule.
scripts/git-hooks/* text eol=lf
