# ---- Claude Code / agent local files (session residue, machine-local settings) ----
# .claude/settings.json is tracked: it holds the project's PreToolUse guard (.claude/hooks/guard_commands.py).
.claude/logs/
.claude/settings.local.json
.superpowers/

# ---- Scratch / temp (project rule: temp files live in temp/) ----
temp/
tmp/
__pycache__/
*.pyc

# ---- Raw run data: bags are large; artifacts/ keeps samples, summaries and logs ----
artifacts/**/rosbag/
# verify.sh records (every commit makes one through the pre-commit hook); a record kept as evidence is added with -f
artifacts/verify/
*.db3
*.mcap

# ---- Machine-specific network config generated from a tracked template ----
configs/network/*.generated.xml
configs/network/*.peers.xml

# ---- Secrets ----
.env
.env.*

# ---- OS / IDE noise ----
.DS_Store
Thumbs.db

# ---- Runtime pid files written by the recorder/launch scripts (transient; PIDs are recorded in commands.md) ----
artifacts/**/*.pid
artifacts/**/pid-*
# (*.err recorder stderr files are kept: small, and they are failure evidence; see review finding R4)

# ---- Codex review queue: the lock file holds the running queue PID (transient) ----
docs/review/codex-queue.lock
