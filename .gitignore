# ---- Claude Code / agent local files (session residue, machine-local settings) ----
.claude/logs/
.claude/settings.local.json
.claude/settings.json
.superpowers/

# ---- Scratch / temp (project rule: temp files live in temp/) ----
temp/
tmp/
