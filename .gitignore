artifacts/**/rosbag/
*.db3
*.mcap

# ---- Machine-specific network config generated from a tracked template ----
configs/network/*.generated.xml
configs/network/*.peers.xml

# ---- Secrets ----
.env
.env.*

# ---- OS / IDE noise ----
.DS_Store
Thumbs.db
