#usda 1.0
(
    defaultPrim = "Box"
    metersPerUnit = 1
    upAxis = "Z"
    doc = "RoboSim Eval fault-injection obstacle: static 0.8 x 0.8 x 0.10 m box with a collider, below the /scan height band."
)

def Xform "Box"
{
    def Cube "Geom" (
        prepend apiSchemas = ["PhysicsCollisionAPI"]
    )
    {
        double size = 1
        float3[] extent = [(-0.5, -0.5, -0.5), (0.5, 0.5, 0.5)]
        color3f[] primvars:displayColor = [(0.9, 0.8, 0.1)]
        double3 xformOp:translate = (0, 0, 0.05)
        float3 xformOp:scale = (0.8, 0.8, 0.1)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}
